{
  "name": "@gamecrafters/agents",
  "version": "0.0.2",
  "description": "Stateful AI agents with tool calling, session memory, evaluation, and retrieval-augmented generation.",
  "license": "MIT",
  "author": "GameCrafters",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "typescript",
    "evaluation",
    "state-machine",
    "rag",
    "embeddings",
    "chromadb"
  ],
  "homepage": "https://github.com/gamecrafters-io/agents-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/agents-typescript.git",
    "directory": "packages/agents"
  },
  "bugs": {
    "url": "https://github.com/gamecrafters-io/agents-typescript/issues"
  },
  "private": false,
  "type": "module",
  "files": [
    "build"
  ],
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "turbo run build --filter=@gamecrafters/agents...",
    "prepack": "node -e \"const fs = require('node:fs'); fs.copyFileSync('../../README.md', 'README.md'); fs.copyFileSync('../../LICENSE', 'LICENSE');\"",
    "postpack": "node -e \"const fs = require('node:fs'); fs.rmSync('README.md', {force: true}); fs.rmSync('LICENSE', {force: true});\""
  },
  "dependencies": {
    "chromadb": "^3.5.0",
    "openai": "^7.47.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gamecrafters/eslint-config": "*",
    "@gamecrafters/typescript-config": "*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsdown": "^0.23.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
