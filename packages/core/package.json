{
  "name": "@gamecrafters/agents-core",
  "version": "0.0.1",
  "description": "Core primitives for LLM messages, tools, parsing, and agent workflows.",
  "license": "MIT",
  "author": "GameCrafters",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "typescript",
    "state-machine"
  ],
  "homepage": "https://github.com/gamecrafters-io/agents-typescript/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/agents-typescript.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gamecrafters-io/agents-typescript/issues"
  },
  "private": false,
  "type": "module",
  "files": [
    "build"
  ],
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openai": "^7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gamecrafters/eslint-config": "*",
    "@gamecrafters/typescript-config": "*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
