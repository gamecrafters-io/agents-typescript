{
  "name": "agents-typescript",
  "version": "0.0.1",
  "description": "TypeScript libraries for building AI agents, workflows, and retrieval-augmented applications.",
  "license": "MIT",
  "author": "GameCrafters",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "typescript",
    "rag"
  ],
  "homepage": "https://github.com/gamecrafters-io/agents-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/agents-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/gamecrafters-io/agents-typescript/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/config/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "format": "npm run lint:fix && npm run prettier:fix"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
